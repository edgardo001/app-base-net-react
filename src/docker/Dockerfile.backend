FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG BUILD_CONFIGURATION=Release
WORKDIR /src

# Layer 1: restore con cache de NuGet (solo cambia si .csproj cambia)
COPY ["src/backend/UserManagement.Domain/UserManagement.Domain.csproj", "backend/UserManagement.Domain/"]
COPY ["src/backend/UserManagement.Application/UserManagement.Application.csproj", "backend/UserManagement.Application/"]
COPY ["src/backend/UserManagement.Infrastructure/UserManagement.Infrastructure.csproj", "backend/UserManagement.Infrastructure/"]
COPY ["src/backend/UserManagement.WebApi/UserManagement.WebApi.csproj", "backend/UserManagement.WebApi/"]
RUN dotnet restore "backend/UserManagement.WebApi/UserManagement.WebApi.csproj"

# Layer 2: build y publish
COPY ["src/backend/", "backend/"]
WORKDIR "/src/backend/UserManagement.WebApi"
RUN dotnet build -c $BUILD_CONFIGURATION --no-restore
RUN dotnet publish -c $BUILD_CONFIGURATION -o /app --no-build

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
EXPOSE 8080
COPY --from=build /app .
ENTRYPOINT ["dotnet", "UserManagement.WebApi.dll"]
