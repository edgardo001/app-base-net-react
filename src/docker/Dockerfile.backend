FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG BUILD_CONFIGURATION=Release
ENV NUGET_FALLBACK_PACKAGES=
WORKDIR /src

# Layer 1: restore con cache de NuGet (solo cambia si .csproj cambia)
COPY ["src/backend/AppBaseNetReact.Domain/AppBaseNetReact.Domain.csproj", "backend/AppBaseNetReact.Domain/"]
COPY ["src/backend/AppBaseNetReact.Application/AppBaseNetReact.Application.csproj", "backend/AppBaseNetReact.Application/"]
COPY ["src/backend/AppBaseNetReact.Infrastructure/AppBaseNetReact.Infrastructure.csproj", "backend/AppBaseNetReact.Infrastructure/"]
COPY ["src/backend/AppBaseNetReact.WebApi/AppBaseNetReact.WebApi.csproj", "backend/AppBaseNetReact.WebApi/"]
COPY ["nuget.config", "."]
RUN dotnet restore "backend/AppBaseNetReact.WebApi/AppBaseNetReact.WebApi.csproj"

# Layer 2: build y publish
COPY ["src/backend/", "backend/"]
WORKDIR "/src/backend/AppBaseNetReact.WebApi"
RUN dotnet build -c $BUILD_CONFIGURATION --no-restore
RUN dotnet publish -c $BUILD_CONFIGURATION -o /app --no-build

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
RUN apt-get update && apt-get install -y wget && rm -rf /var/lib/apt/lists/*
WORKDIR /app
EXPOSE 8080
COPY --from=build /app .
ENTRYPOINT ["dotnet", "AppBaseNetReact.WebApi.dll"]
