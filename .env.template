# =============================================================================
# User Management Platform — Environment Variables
# =============================================================================
# Copia este archivo a .env y completa los valores.
# .env esta en .gitignore — NUNCA subas credenciales al repositorio.

# --- PostgreSQL ---
POSTGRES_DB=CHANGE_ME
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
# ConnectionStrings__PostgreSQL se lee via IConfiguration.GetConnectionString("PostgreSQL")
ConnectionStrings__PostgreSQL=Host=localhost;Port=5432;Database=mvp-usuarios-db;Username=mvp-usuarios-db;Password=CHANGE_ME

# --- JWT (HS512) ---
# SecretKey debe tener al menos 64 caracteres (512 bits para HS512)
JWT_SECRET_KEY=CHANGE_ME_MIN_64_CHARS__________________________________________________
Jwt__SecretKey=CHANGE_ME_MIN_64_CHARS__________________________________________________
Jwt__Issuer=mvp-usuarios
Jwt__Audience=mvp-usuarios-api
Jwt__AccessTokenExpirationMinutes=15
Jwt__RefreshTokenExpirationDays=7
Jwt__ClockSkewSeconds=60

# --- Cloudflare Turnstile (Captcha condicional) ---
Captcha__SiteKey=
Captcha__SecretKey=

# --- Cloudflare DNS Edit Zone ---
# Cloudflare API Token - REEMPLAZA con tu token real
# Pasos para crear token en cloudflare.com:
# 1. Ir a https://dash.cloudflare.com/profile/api-tokens
# 2. "Create Token" -> "Edit zone DNS"
# 3. Permisos: Zone:DNS:Edit
# 4. Recursos: Include -> Specific zone -> edgardovasquez.cl
# 5. Crear y copiar el token aqui
CF_DNS_API_TOKEN=CHANGE_ME
# Credenciales para el dashboard de Traefik (Formato: usuario:hash)
# Para generar el hash:
#   - Con contenedor (Recomendado): docker run --rm httpd:alpine htpasswd -nb usuario contraseña
#   - Online: Buscar "Htpasswd Generator" (usar algoritmo MD5/apr1)
# IMPORTANTE: Debes duplicar los signos '$' en el hash resultante (ej. '$apr1$' -> '$$apr1$$') para evitar problemas de escape en docker-compose.
TRAEFIK_PASS_HASH=CHANGE_ME

# --- SMTP (Email de confirmacion/reseteo) ---
SMTP_PROVIDER=Smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME@gmail.com
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_EMAIL=CHANGE_ME@gmail.com
SMTP_FROM_NAME="Sistema Gesti\u00f3n Usuarios"

# --- Traefik & Domain Routing ---
# Define los dominios publicos que apuntaran a los servicios a traves de Traefik.
# Asegúrate de configurar los registros DNS (A o CNAME) correspondientes en Cloudflare.
FRONTEND_DOMAIN=app.example.com
BACKEND_DOMAIN=api.example.com

