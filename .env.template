# =============================================================================
# User Management Platform — Environment Variables
# =============================================================================
# Copia este archivo a .env y completa los valores.
# .env esta en .gitignore — NUNCA subas credenciales al repositorio.

# --- PostgreSQL ---
# ConnectionStrings__PostgreSQL se lee via IConfiguration.GetConnectionString("PostgreSQL")
ConnectionStrings__PostgreSQL=Host=localhost;Port=5432;Database=mvp-usuarios-db;Username=mvp-usuarios-db;Password=CHANGE_ME

# --- JWT (HS512) ---
# SecretKey debe tener al menos 64 caracteres (512 bits para HS512)
Jwt__SecretKey=CHANGE_ME_MIN_64_CHARS__________________________________________________
Jwt__Issuer=mvp-usuarios
Jwt__Audience=mvp-usuarios-api
Jwt__AccessTokenExpirationMinutes=15
Jwt__RefreshTokenExpirationDays=7
Jwt__ClockSkewSeconds=60

# --- Cloudflare Turnstile (Captcha condicional) ---
Captcha__SiteKey=
Captcha__SecretKey=

# --- SMTP (Email de confirmacion/reseteo) ---
Email__Smtp__Host=
Email__Smtp__Port=587
Email__Smtp__Username=
Email__Smtp__Password=
Email__Smtp__From=noreply@example.com
Email__Smtp__FromName=User Management
